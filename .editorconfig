# Matches what the repo already contains: shell and Makefile recipes are tab-indented, everything
# structured (compose, workflows, toml) is two spaces. Documentation keeps its trailing whitespace
# because a Markdown line break is two trailing spaces.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{sh,bash}]
indent_style = tab

[Makefile]
indent_style = tab

[*.{yaml,yml,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
