# Compose variables, no secrets. Instance secrets: examples/<name>/env.

# Local `make image` builds agentbox:dev; production uses a CI-published version, e.g. ghcr.io/<repo>:1.2.3.
AGENTBOX_IMAGE=agentbox:dev
AGENTBOX_IMAGE_PI=agentbox:dev-pi

# Runtime mirrors (etc/agentbox/profiles/cn.env). Unset = upstream.
# AGENTBOX_PROFILE=cn

# One workspace per instance under this directory, owned by the image's AGENT_UID.
WORKSPACES_ROOT=./runtime/workspaces

# Optional shared script library mounted at /opt/toolkit.
TOOLKIT_DIR=./runtime/toolkit

AGENT_PIDS_LIMIT=512
