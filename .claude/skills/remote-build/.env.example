# Remote build host for the remote-build skill. Copy to .env (gitignored); flags and env vars override.
# Behind a rule-based proxy (Clash) write the host as <ip>.sslip.io and set the alias to the bare ip.
AGENTBOX_REMOTE=user@xxx.xxx.xxx.xxx.sslip.io
AGENTBOX_REMOTE_KEY=~/.ssh/xxxx.pem
AGENTBOX_REMOTE_DIR=/data/agentbox
# AGENTBOX_REMOTE_SOCKS=127.0.0.1:7890
# AGENTBOX_REMOTE_HOST_KEY_ALIAS=xxx.xxx.xxx.xxx
