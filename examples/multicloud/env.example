# Instance secrets (S0/S1, see docs/CREDENTIALS.md section 1). Copy to `env`, chmod 600, never commit.
# config.toml references these by ${NAME} only. Cloud credentials are NOT here: they are files
# under home/ (see home/accounts.yaml).

# Chat platform (Feishu): one app for the one bot
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Allow lists: explicit open_ids as seen by THIS app, comma separated. Never "*".
ALLOW_FROM=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_FROM=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model gateway. Use a budgeted virtual key, not a master key.
# Verify the pair with curl against $ANTHROPIC_BASE_URL/v1/messages first: on a wrong host or key
# Claude Code hangs instead of failing.
ANTHROPIC_BASE_URL=https://llm-gateway.example.com
ANTHROPIC_AUTH_TOKEN=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# Non-Anthropic model behind the gateway: uncomment here and in config.toml [projects.agent.options.env]
# ANTHROPIC_MODEL=vendor/model-name
# ANTHROPIC_DEFAULT_HAIKU_MODEL=vendor/model-name
# ANTHROPIC_DEFAULT_SONNET_MODEL=vendor/model-name
# ANTHROPIC_DEFAULT_OPUS_MODEL=vendor/model-name
# CLAUDE_CODE_SUBAGENT_MODEL=vendor/model-name
# CLAUDE_CODE_AUTO_COMPACT_WINDOW=900000
