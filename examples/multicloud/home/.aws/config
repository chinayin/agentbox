# AWS CLI config and credentials in one file: the CLI reads aws_access_key_id from the config
# file too, so no credentials file exists. No [default] on purpose: a command without --profile
# fails (AWS_EC2_METADATA_DISABLED=true in config.toml keeps it from falling back to IMDS).
# Profile names are the aliases in accounts.yaml. Use dedicated read-only IAM users, one per account.

[profile acme-prod]
aws_access_key_id = AKIAxxxxxxxxxxxxxxxx
aws_secret_access_key = xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
region = us-east-1
output = json

[profile acme-dev]
aws_access_key_id = AKIAxxxxxxxxxxxxxxxx
aws_secret_access_key = xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
region = us-east-1
output = json
